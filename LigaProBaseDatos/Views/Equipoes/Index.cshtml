@model IEnumerable<LigaProBaseDatos.Models.Equipo>

@{
    ViewData["Title"] = "Lista de Equipos";
}

<h1>Equipos</h1>

<p>
    <a asp-action="Create">Ingresar Equipo</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PartidosJugados)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PartidosGanados)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PartidosEmpatados)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PartidosPerdidos)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PartidosJugados)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PartidosGanados)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PartidosEmpatados)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PartidosPerdidos)
            </td>
            <td>
                    <a class="btn btn-success me-2" a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <a class="btn btn-info me-2" a asp-action="Details" asp-route-id="@item.Id">Details</a>
                    <a class="btn btn-warning me-2" a asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
