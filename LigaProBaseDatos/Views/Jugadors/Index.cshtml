@model IEnumerable<LigaProBaseDatos.Models.Jugador>

@{
    ViewData["Title"] = "Lista de jugadores";
}

<h1>Jugadores</h1>

<p>
    <a asp-action="Create">Ingresar Jugador</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NumeroCamiseta)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Goles)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Asistencias)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Sueldo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Posicion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Equipo)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NumeroCamiseta)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Goles)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Asistencias)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Sueldo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Posicion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Equipo.Nombre)
            </td>
            <td>
                    <a class=" btn btn-success me-2" a asp-action="Edit" asp-route-id="@item.JugadorId">Edit</a> 
                    <a class=" btn btn-info me-2" a asp-route-id="@item.JugadorId">Details</a> 
                    <a class=" btn btn-warning me-2" a asp-route-id="@item.JugadorId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
